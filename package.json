{
  "name": "agency-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" && node tests/api-imports.test.mjs",
    "db:setup": "node --import tsx scripts/db.ts setup",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:status": "node --import tsx scripts/db.ts status",
    "db:make-staff": "node --import tsx scripts/dev-data.ts make-staff",
    "db:seed": "node --import tsx scripts/dev-data.ts seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
