# cp .env.example .env.local   (then fill in what you need)
# Locally, every variable is optional: without database or email keys the dev
# server stores requests in memory and prints emails to the terminal.
# In production (Vercel) the first three are required.

# Required in production. Neon Postgres connection string (Neon dashboard → Connection details).
# DATABASE_URL is accepted as an alias.
POSTGRES_URL=

# Required in production. Resend API key (resend.com → API Keys).
RESEND_API_KEY=

# Required in production. Sender address on a domain verified in Resend, e.g. requests@yourdomain.com.
BOOKING_FROM_EMAIL=

# Optional. Inbox that receives new job requests. Default: lai@hendersonassociates.ca
# (edrine.e@hendersonassociates.ca on Vercel preview deploys).
BOOKING_INTERNAL_TO=

# Optional. https link to your booking calendar, shown after submitting and in the
# confirmation email. Built into the page, so redeploy after changing it.
VITE_BOOKING_CALENDAR_URL=

# Optional. Set to 0 to disable the local in-memory store and console email.
BOOKING_DEV_FAKES=

# Optional. Set to 1 to allow a production build with the placeholder brand.
ALLOW_PLACEHOLDER_BRAND=

# Optional. Set to 1 to switch on the staff area (/admin) on Vercel. It is off on
# production and preview deploys until this is set, and on in local development.
FEATURE_ADMIN=

# Optional. Set to 1 to switch on client shortlist links (/shortlist) on Vercel.
# Off on production and preview deploys until set; on in local development.
FEATURE_SHORTLIST=

# Optional. The site's address for links in emails (no trailing slash), e.g.
# https://agency.com. Default: Vercel's production domain on production, the
# deploy's own URL on previews, the dev server locally.
SITE_URL=

# Optional. Comma-separated email domains allowed to sign in to /admin.
# Default: hendersonassociates.ca
STAFF_EMAIL_DOMAINS=

# Optional. Host name of the production database (e.g. ep-xxx.region.aws.neon.tech).
# npm run db:migrate refuses this host unless run interactively with --production.
PRODUCTION_DB_HOST=
